{
  "schemaVersion": 1,
  "independent_connector": {
    "schemaVersion": 1,
    "id": "talia-connectors/atlassian-confluence",
    "auth": "user_choice",
    "scope": "space",
    "operations": [
      {
        "id": "space",
        "method": "GET",
        "route": "/rest/api/space/{scope}"
      },
      {
        "id": "pages",
        "method": "GET",
        "route": "/rest/api/space/{scope}/content/page"
      }
    ]
  }
}
